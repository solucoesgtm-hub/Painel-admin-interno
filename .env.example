# Copie para .env.local e preencha. Nunca envie o .env.local ao GitHub.

# --- Banco (Neon) ---
# Conexão "pooled" (com "-pooler"). Sem ela, o Hub roda em modo demonstração.
DATABASE_URL=
# Conexão direta (sem "-pooler"). Só para migrações.
DATABASE_URL_UNPOOLED=
# Sócios para o cadastro inicial: Nome|email|Área;Nome|email|Área
SOCIOS=

# --- Login (Auth.js, e-mail e senha) ---
# Gere com: npx auth secret   (precisa também da DATABASE_URL, onde ficam as senhas)
AUTH_SECRET=
# Opcional: trava extra. Só estes e-mails podem entrar (separados por vírgula)
SOCIOS_EMAILS=

# --- IA (Claude) — usado a partir da Fase 2 ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
IA_TETO_MENSAL_BRL=

# --- Banco Inter (Fase 5) — "demo" ou "inter" ---
PROVEDOR_BANCARIO=demo

# --- Financeiro ---
MEI_LIMITE_ANUAL=81000

# --- Google Agenda (conta de serviço) — passo a passo em docs/GOOGLE-AGENDA.md ---
# ID da agenda da GTM (Configurações da agenda → Integrar agenda → ID da agenda)
GOOGLE_AGENDA_ID=
# Conteúdo inteiro do JSON da chave da conta de serviço, em uma linha (entre aspas simples)
GOOGLE_AGENDA_CREDENCIAIS=
