# Copie para .env.local e preencha. Nunca envie o .env.local ao GitHub.

# --- Banco (Neon) ---
# Conexão "pooled" (com "-pooler"). Sem ela, o Hub roda em modo demonstração.
DATABASE_URL=
# Conexão direta (sem "-pooler"). Só para migrações.
DATABASE_URL_UNPOOLED=
# Sócios para o cadastro inicial: Nome|email|Área;Nome|email|Área
SOCIOS=

# --- Login (Auth.js + Google) ---
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# E-mails autorizados, separados por vírgula
SOCIOS_EMAILS=

# --- IA (Claude) — usado a partir da Fase 2 ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
IA_TETO_MENSAL_BRL=

# --- Banco Inter (Fase 5) — "demo" ou "inter" ---
PROVEDOR_BANCARIO=demo

# --- Financeiro ---
MEI_LIMITE_ANUAL=81000
