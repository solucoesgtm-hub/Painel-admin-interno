# Copie para .env.local e preencha. Nunca envie o .env.local ao GitHub.

# --- Banco (Neon) ---
# Conexão "pooled" (com "-pooler"). Sem ela, o Hub roda em modo demonstração.
DATABASE_URL=
# Conexão direta (sem "-pooler"). Só para migrações.
DATABASE_URL_UNPOOLED=
# Sócios para o cadastro inicial: Nome|email|Área;Nome|email|Área
SOCIOS=

# --- Login (Auth.js, e-mail e senha) ---
# Gere com: npx auth secret   (precisa também da DATABASE_URL, onde ficam as senhas)
AUTH_SECRET=
# Opcional: trava extra. Só estes e-mails podem entrar (separados por vírgula)
SOCIOS_EMAILS=

# Todas as conexões aparecem em /conexoes (situação + botão Testar). Passo a passo: docs/CONEXOES.md

# --- IA (Claude): análise do diagnóstico (relatório e plano) e triagem do e-mail ---
# Crie em console.anthropic.com. Sem ela, o botão gera um exemplo montado pelo sistema
# a partir do diagnóstico (sem custo). Com ela, o mesmo botão passa a usar a IA.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Modelo barato para tarefas curtas e repetidas (triagem de e-mail)
CLAUDE_MODELO_RAPIDO=claude-haiku-5-5
# Teto de gasto por mês em reais (vazio = 50). Ao atingir, as gerações param até o mês seguinte.
IA_TETO_MENSAL_BRL=
# Cotação do dólar usada só para estimar o custo (vazio = 5,50)
IA_COTACAO_DOLAR=

# --- Banco Inter (somente leitura: saldo e extrato) — "demo" ou "inter" ---
PROVEDOR_BANCARIO=demo
# Da aplicação criada no Internet Banking do Inter Empresas → Integrações
INTER_CLIENT_ID=
INTER_CLIENT_SECRET=
# Arquivos .crt e .key da aplicação: o PEM inteiro ou o arquivo em base64 (uma linha)
INTER_CERTIFICADO=
INTER_CHAVE=
# "producao" (padrão) ou "sandbox"
INTER_AMBIENTE=producao
# Opcional: número da conta, se houver mais de uma
INTER_CONTA=

# --- Gmail (triagem da caixa e rascunhos de resposta; nunca envia sozinho) ---
# Cliente OAuth "App para computador" no Google Cloud; o token sai de: npm run gmail:autorizar
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- WhatsApp Business (Cloud API da Meta) ---
# Token permanente de um usuário do sistema (Gerenciador de Negócios)
WHATSAPP_TOKEN=
# "Phone number ID" do número (não é o telefone)
WHATSAPP_NUMERO_ID=
# Chave secreta do app (confere a assinatura do webhook)
META_APP_SECRET=
# Texto livre, o mesmo informado ao cadastrar o webhook: https://SEU-DOMINIO/api/whatsapp/webhook
WHATSAPP_VERIFY_TOKEN=
# Opcional: versão da Graph API (padrão v23.0)
META_GRAPH_VERSAO=

# --- Financeiro ---
MEI_LIMITE_ANUAL=81000

# --- Google Agenda (conta de serviço) — passo a passo em docs/GOOGLE-AGENDA.md ---
# ID da agenda da GTM (Configurações da agenda → Integrar agenda → ID da agenda)
GOOGLE_AGENDA_ID=
# Conteúdo inteiro do JSON da chave da conta de serviço, em uma linha (entre aspas simples)
GOOGLE_AGENDA_CREDENCIAIS=

# --- Notificações do chat (Web Push) — gere com: npx web-push generate-vapid-keys ---
VAPID_PUBLIC_KEY=
# Segredo: só no servidor (Vercel → Environment Variables)
VAPID_PRIVATE_KEY=
# Contato exigido pelos serviços de push (mailto: ou https:// do site)
VAPID_CONTATO=
